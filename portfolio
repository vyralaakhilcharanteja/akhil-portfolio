.detail-row small{display:block;color:#b8c2d5;font-size:9px}.detail-row strong{display:block;font-size:11px;margin-top:2px}

/* SKILLS */
.split-title{display:flex;align-items:flex-end;justify-content:space-between}
.hand-note-inline{font-family:Kalam,cursive;color:#7fd5ff;font-size:14px;transform:rotate(-5deg);margin-bottom:5px}
.hand-note-inline i{width:45px;margin-left:auto}
.skills-grid{display:grid;grid-template-columns:repeat(8,1fr);gap:10px}
.skill{min-height:99px;padding:12px 8px;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;transition:.25s}
.skill:hover{transform:translateY(-5px);border-color:#5e92ff}
.skill-icon{height:31px;font-size:25px;line-height:1;color:#a66cff;margin-bottom:9px}
.skill:nth-child(2) .skill-icon,.skill:nth-child(6) .skill-icon{color:#48baff}
.skill h3{font-size:10px;line-height:1.18}
.skill small{font-size:8px;color:#b9c4d8}

/* EXPERIENCE */
.experience-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}
.experience-card{display:grid;grid-template-columns:62px 1fr;gap:16px;padding:12px 14px}
.company-mark{height:52px;width:52px;border-radius:7px;display:grid;place-items:center;font-weight:900;font-size:12px;color:#fff;background:#05070c}
.google{background:radial-gradient(circle,#fff 15%,#4285f4 16%,#34a853 50%,#fbbc05 68%,#ea4335 82%);font-size:28px}
.experience-heading{display:flex;justify-content:space-between;gap:8px;align-items:center}
.experience-heading h3{font-size:14px}.date-badge{font-size:9px;padding:5px 10px;border-radius:6px;background:rgba(83,105,185,.3);color:#d6ddff}
.experience-content ul{margin:8px 0 0 14px;color:#e0e5ee;font-size:10px;line-height:1.3}.experience-content li{margin:4px 0}

/* PROJECTS */
.projects-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}
.project-card{display:grid;grid-template-columns:132px 1fr;gap:18px;padding:10px}
.project-image{min-height:118px;border-radius:7px;overflow:hidden;position:relative;background:#061125;border:1px solid rgba(100,150,255,.22)}
.stock-image{background:radial-gradient(circle at 50% 50%,#123c63,#061022 60%),repeating-linear-gradient(0deg,transparent 0 19px,rgba(120,175,255,.12) 20px)}
.chart-line{position:absolute;inset:20px 10px 26px;background:linear-gradient(140deg,transparent 0 7%,#4cbcff 8% 10%,transparent 11% 18%,#3b9eff 19% 21%,transparent 22% 32%,#8d6cff 33% 35%,transparent 36% 47%,#51d3ff 48% 50%,transparent 51% 61%,#6c82ff 62% 64%,transparent 65% 77%,#b55cff 78% 80%,transparent 81%);filter:drop-shadow(0 0 5px #5caeff)}
.chart-bars{position:absolute;left:12px;right:12px;bottom:11px;display:flex;align-items:flex-end;gap:7px;height:45px}.chart-bars i{display:block;width:14px;background:linear-gradient(#35c9ff,#7057ff);height:30%}.chart-bars i:nth-child(2){height:55%}.chart-bars i:nth-child(3){height:42%}.chart-bars i:nth-child(4){height:75%}.chart-bars i:nth-child(5){height:95%}
.code-image{padding:15px;background:linear-gradient(140deg,#0c2344,#030b1b)}.code-image>span{font-size:31px;color:#61baff;display:block}.code-lines{margin-top:7px}.code-lines i{display:block;height:4px;border-radius:2px;background:#3c8cff;margin:5px 0;width:70%}.code-lines i:nth-child(2){width:45%;background:#a35eff}.code-lines i:nth-child(3){width:82%;background:#39d7ff}.code-lines i:nth-child(4){width:58%;background:#6576ff}.code-lines i:nth-child(5){width:75%;background:#a35eff}.code-lines i:nth-child(6){width:40%;background:#3c8cff}
.project-body h3{font-size:13px;margin-bottom:5px}.project-body ul{margin-left:15px;color:#e0e6f1;font-size:10px;line-height:1.35}.project-body li{margin:3px 0}.tags{display:flex;flex-wrap:wrap;gap:5px;margin-top:9px}.tags span{font-size:8px;padding:5px 8px;border-radius:999px;background:rgba(63,87,171,.38);border:1px solid rgba(117,145,255,.22)}

/* EDUCATION */
.education-grid{display:grid;grid-template-columns:1.3fr 1fr 1fr;gap:14px}
.education-card{position:relative;display:flex;gap:14px;align-items:flex-start;padding:14px}
.education-icon{font-size:25px;color:#8bbfff;line-height:1.1}.education-card h3{font-size:13px}.education-card p{font-size:10px;color:#edf1f8}.education-card strong{color:#fff}.status{position:absolute;right:10px;top:10px;font-size:8px;padding:4px 8px;border-radius:5px;background:rgba(109,71,196,.45);color:#dfd5ff}

/* TECHNICAL */
.compact-section{padding-top:55px}
.technical-cloud{padding:18px;display:flex;gap:8px;flex-wrap:wrap}
.technical-cloud span{padding:7px 10px;border-radius:8px;background:rgba(20,47,96,.45);border:1px solid rgba(100,147,255,.2);font-size:10px;color:#dfe6f5}

/* CONTACT */
.contact-heading{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin-bottom:20px}
.contact-heading>p{color:#c7d0df;font-size:11px}
.contact-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}
.contact-pill{min-height:44px;padding:10px 13px;display:flex;align-items:center;gap:10px;text-decoration:none}
.contact-pill>span{font-size:18px;color:#6ecbff;font-weight:800}.contact-pill strong{font-size:9px;overflow-wrap:anywhere}
.contact-note{position:absolute;right:8%;margin-top:-55px}.contact-section .container{position:relative}

/* FOOTER */
.footer{padding:20px 0 25px;border-top:1px solid rgba(90,137,235,.16)}
.footer-inner{display:flex;align-items:center;justify-content:space-between;gap:20px}
.footer strong{display:block;font-size:15px}.footer strong span{color:#55b8ff}.footer small{font-size:9px;color:#a9b4c7}.footer p{font-size:9px;color:#a9b4c7}.back-top{width:30px;height:30px;border-radius:50%;display:grid;place-items:center;text-decoration:none;background:rgba(49,80,154,.38);color:#fff}

/* RESPONSIVE */
@media(max-width:1000px){
  .nav-links{gap:17px}.skills-grid{grid-template-columns:repeat(4,1fr)}
  .hero-grid{grid-template-columns:1fr .8fr}.hero h1{font-size:45px}
  .photo-ring{width:280px;height:280px}
}
@media(max-width:760px){
  .container{width:min(100% - 28px,1100px)}
  .site-header .nav{height:64px}.menu-toggle{display:block;margin-left:auto}
  .menu-toggle span{display:block;width:24px;height:2px;background:#fff;margin:5px}
  .nav-links{
    position:absolute;top:64px;left:14px;right:14px;display:none;
    flex-direction:column;gap:0;padding:10px;background:rgba(3,9,24,.97);
    border:1px solid var(--line);border-radius:12px
  }
  .nav-links.open{display:flex}.nav-links li{width:100%}.nav-links a{display:block;padding:11px}
  .nav-resume{display:none}
  .hero{padding-top:95px;min-height:auto}.hero-grid{grid-template-columns:1fr;text-align:center}
  .hero-description{margin-left:auto;margin-right:auto}.hero-buttons,.social-row{justify-content:center}
  .hero-photo-wrap{min-height:390px;order:-1}.photo-ring{width:250px;height:250px}.note-top{right:2%;top:22px;font-size:16px}.stat-card{right:0;bottom:25px;width:132px}
  .about-grid,.experience-grid,.projects-grid{grid-template-columns:1fr}.skills-grid{grid-template-columns:repeat(2,1fr)}
  .education-grid{grid-template-columns:1fr}.contact-grid{grid-template-columns:1fr 1fr}
  .contact-heading{align-items:flex-start;flex-direction:column}.contact-note{display:none}
  .footer-inner{flex-wrap:wrap}
}
@media(max-width:450px){
  .hero h1{font-size:39px}.hero h2{font-size:14px}.hero-description{font-size:12px}
  .social{font-size:8px}.social-row{gap:10px}
  .hero-photo-wrap{min-height:350px}.photo-ring{width:220px;height:220px}
  .stat-card{right:-3px;bottom:15px}.note-top{right:-3px}
  .section{padding:68px 0}.section-title h2,.contact-heading h2{font-size:22px}
  .skills-grid{grid-template-columns:repeat(2,1fr);gap:8px}.skill{min-height:92px}
  .experience-card{grid-template-columns:48px 1fr}.company-mark{width:44px;height:44px;font-size:9px}
  .experience-heading{align-items:flex-start;flex-direction:column}.project-card{grid-template-columns:1fr}.project-image{min-height:140px}
  .contact-grid{grid-template-columns:1fr}.footer-inner{flex-direction:column;align-items:flex-start}
}
